[Unit]
Description=Verified local backups of trough and slopd
Documentation=https://github.com/slopmaxxer/server-backups

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/slop-backups/backup.py
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=10min
PrivateTmp=yes
ProtectHome=yes
PrivateNetwork=yes
